rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sales: Jedes authentifizierte Gerät darf schreiben.
    // Lesen nur eigene Sales (nach deviceId oder userId).
    match /sales/{saleId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['id', 'total', 'createdAt', 'type', 'lineItems'])
                    && request.resource.data.total is int
                    && request.resource.data.total >= 0;
      allow read: if request.auth != null;
      allow update, delete: if false; // Sales sind unveränderlich
    }

    // Produkte & Kategorien: nur authentifizierte Geräte lesen/schreiben
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read, write: if request.auth != null;
    }
  }
}
